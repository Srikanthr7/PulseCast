# Server Port
PORT=8080

# MongoDB Connection URI (Local or Atlas)
MONGODB_URI=mongodb://localhost:27017

# Database Name
DB_NAME=pulsecast

# Redis Configuration (Local or Cloud Upstash / Redis Cloud)
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
# REDIS_URL=redis://default:...@...:6379

# JWT Secret Key for Creator Authentication
JWT_SECRET=pulsecast_super_secret_jwt_key_2026

# Gin Environment (debug / release)
GIN_MODE=debug

# Google OAuth 2.0 Client ID (optional, matches frontend VITE_GOOGLE_CLIENT_ID to verify token audience)
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
